# =============================================================================
# Unreal Engine 5 — .gitattributes (범용 템플릿)
# 사용법: 프로젝트 루트에 복사
# =============================================================================

# 기본 동작: 텍스트 파일 줄바꿈 자동 정규화
* text=auto

# 저작 시트 스냅샷 CSV — manifest 해시가 구글 export 원시 바이트(CRLF)라 체크아웃 줄바꿈도 CRLF 로 고정한다.
# core.autocrlf 가 다른 머신에서 거짓 LOCAL-AHEAD 가 나지 않게(SHEET1 G2 P3 · 명세 §11 R3).
# ST_Card.csv 는 카드 임포터가 쓰는 파생물이라 종전 규칙(text=auto, eol 미지정)으로 되돌린다.
Content/Authoring/*.csv          text eol=crlf
Content/StringTables/*.csv       text eol=crlf
Content/StringTables/ST_Card.csv text=auto !eol

# =============================================================================
# UE5 바이너리 에셋 — diff/merge/줄바꿈 변환 완전 비활성
# =============================================================================
*.uasset    filter=lfs diff=lfs merge=lfs -text
*.umap      filter=lfs diff=lfs merge=lfs -text
*.uassetmeta binary
*.uplugin   binary
*.uproject  binary

# 컴파일된 쉐이더 / 캐시
*.ushaderbytecode binary
*.upipelinecache  binary

# 패키지 / 아카이브
*.pak   binary
*.ucas  binary
*.utoc  binary
*.ubulk binary

# 이미지
*.png   binary
*.tga   binary
*.jpg   binary
*.jpeg  binary
*.bmp   binary
*.tif   binary
*.tiff  binary
*.hdr   binary
*.exr   binary
*.dds   binary

# 오디오
*.wav   binary
*.mp3   binary
*.ogg   binary
*.aif   binary
*.aiff  binary

# 비디오
*.mp4   binary
*.mov   binary
*.avi   binary

# 3D 메시
*.fbx   binary
*.obj   binary
*.3ds   binary

# 폰트
*.ttf   binary
*.otf   binary

# 압축
*.zip   binary
*.7z    binary
*.rar   binary

# =============================================================================
# UE5 / C++ 소스 — CRLF (Windows 기준)
# =============================================================================
*.cpp       text eol=crlf
*.h         text eol=crlf
*.cs        text eol=crlf
*.inl       text eol=crlf
*.usf       text eol=crlf
*.ush       text eol=crlf

# =============================================================================
# 설정 / 마크업 — LF 통일
# =============================================================================
*.ini       text eol=lf
*.json      text eol=lf
*.xml       text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.cfg       text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf
*.webp  binary
