{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__notion-update-page",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File Scripts/pm-board-guard.ps1",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File Scripts/session-resume.ps1",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
